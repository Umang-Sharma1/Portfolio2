# Web Dockerfile for Development
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package.json pnpm-lock.yaml* package-lock.json* yarn.lock* ./
COPY apps/web/package.json ./apps/web/
COPY packages/types/package.json ./packages/types/
COPY packages/utils/package.json ./packages/utils/
COPY packages/ui/package.json ./packages/ui/
COPY packages/config/package.json ./packages/config/

# Install dependencies
RUN npm install -g pnpm && pnpm install --frozen-lockfile || npm install

# Copy source code
COPY apps/web ./apps/web
COPY packages ./packages
COPY tsconfig.json turbo.json ./

# Build packages
RUN npm run build --workspace=packages/types || true
RUN npm run build --workspace=packages/utils || true
RUN npm run build --workspace=packages/ui || true

EXPOSE 3000

# Enable file watching in Docker
ENV WATCHPACK_POLLING=true

# Development command
CMD ["npm", "run", "dev", "--workspace=apps/web"]
